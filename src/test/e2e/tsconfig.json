{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023", "DOM"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["cypress"],
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "paths": {
            "@/*": ["../../*"]
        }
    },
    "include": ["**/*.ts"]
}
